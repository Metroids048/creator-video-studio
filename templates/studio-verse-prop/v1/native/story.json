{
  "kind": "verse-prop",
  "title": "见字，如见你",
  "duration": 24,
  "scenes": [
    {
      "start": 0,
      "end": 6,
      "text": "把远方，折进一封信。"
    },
    {
      "start": 6,
      "end": 12,
      "text": "把想念，藏进一把扇。"
    },
    {
      "start": 12,
      "end": 18,
      "text": "把风声，系成一条红绸。"
    },
    {
      "start": 18,
      "end": 24,
      "text": "等你回来，便是春天。"
    }
  ]
}
