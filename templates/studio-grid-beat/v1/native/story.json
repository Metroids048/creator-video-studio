{
  "kind": "grid-beat",
  "title": "留着一扇灯",
  "duration": 32,
  "category": "九格插画编舞 · 城市小故事",
  "endline": "这一盏，等你回来。",
  "scenes": [
    {
      "start": 0,
      "end": 8,
      "text": "夜里，每一扇窗都有自己的生活。"
    },
    {
      "start": 8,
      "end": 16,
      "text": "有人热饭，有人翻书，有猫睡熟。"
    },
    {
      "start": 16,
      "end": 23,
      "text": "灯一盏盏熄了，还有一盏亮着。"
    },
    {
      "start": 23,
      "end": 32,
      "text": "因为晚归的人，也值得被等一等。"
    }
  ]
}
