{
  "kind": "rain-ripples",
  "title": "雨停之后",
  "duration": 30,
  "category": "自然水面 · 音乐诗",
  "scenes": [
    {
      "start": 0,
      "end": 7,
      "text": "雨落下，每一滴都有回声。"
    },
    {
      "start": 7,
      "end": 14,
      "text": "碰见另一圈，就一起走远。"
    },
    {
      "start": 14,
      "end": 21,
      "text": "有些事，急也急不来。"
    },
    {
      "start": 21,
      "end": 30,
      "text": "等雨停，水面会把月亮还给你。"
    }
  ]
}
